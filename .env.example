# Copy to .env and fill in. .env is gitignored (G6).

# OpenAI: used ONLY for embeddings (text-embedding-3-small).
# Anthropic has no embeddings API, so retrieval's dense half needs this.
OPENAI_API_KEY=sk-...

# Anthropic: used for the chat LLM (decomposition + synthesis), temperature 0.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: require this key via the x-api-key header for expensive API endpoints.
FINSIGHT_API_KEY=

# Optional: per-IP request cap for guarded endpoints.
FINSIGHT_RATE_LIMIT_PER_MINUTE=60

# Optional: set to 0 to disable the cross-encoder reranker (skips the
# sentence-transformers/torch import). Default 1 locally, 0 in the deploy image.
FINSIGHT_USE_RERANKER=1

# Optional durable store for users/sessions/portfolio/watchlist/chat/audit/metrics.
# Unset → sqlite at data/sessions.sqlite3. Set to a Supabase (or any) Postgres URI
# for production so account data survives Render redeploys. Filing corpus / Chroma
# are unaffected either way. Prefer Supabase's pooled connection string when available.
DATABASE_URL=

# Optional future cache; local dev falls back to in-memory state.
REDIS_URL=

# --- Google OAuth (optional) — login is additive; without these the app runs anonymous-only
# and the Sign-in button is hidden. Authorized redirect URI in Google Cloud Console must be:
#   {FINSIGHT_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used to build the OAuth redirect_uri (no trailing slash).
# Local: http://localhost:8000   Production: https://your-service.onrender.com
FINSIGHT_BASE_URL=http://localhost:8000
# Set to 1 behind HTTPS (Render sets this). Must match when clearing session cookies.
FINSIGHT_COOKIE_SECURE=0
# Comma-separated emails that can open /admin after signing in.
FINSIGHT_ADMIN_EMAILS=
